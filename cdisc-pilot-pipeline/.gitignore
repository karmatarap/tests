# Python
__pycache__/
*.py[cod]
*$py.class
.Python
*.egg-info/
.eggs/
*.egg
.venv/
venv/
ENV/

# R
.Rhistory
.Rdata
.RData
.Ruserdata
*.Rproj.user/

# Generated data (regenerated by pipeline)
data/adam/*.xpt
data/tlf/*.rtf

# Source SDTM data (downloaded from PHUSE)
data/sdtm/*.xpt

# Ground truth data (downloaded from PHUSE)
tests/ground_truth/adam/*.xpt

# Logs
logs/**/*.log

# Reports (regenerated)
reports/qc/*.html
reports/exceptions/*.json
reports/pipeline_summary.json

# Benchmarks
tests/benchmarks/*.html

# Temporary files
*.tmp
*.temp
*.swp
*~

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.sublime-*

# Snakemake
.snakemake/

# Conda environments (local)
envs/*.yaml.lock
